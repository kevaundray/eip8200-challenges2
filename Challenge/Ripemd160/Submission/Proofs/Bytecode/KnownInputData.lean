/-- Compact kernel representation of the pinned 1000-byte public vector. -/
def targetInput : ByteArray := ByteArray.mk (Array.replicate 1000 0x61)

def fullWord : UInt256 := UInt256.ofNat
  0x6161616161616161616161616161616161616161616161616161616161616161

def finalWord : UInt256 := UInt256.ofNat
  0x6161616161616161000000000000000000000000000000000000000000000000

def expectedWord (i : Nat) : UInt256 :=
  if i < 31 then fullWord else finalWord

def checks : List (Nat × UInt256) :=
  (List.range 32).map fun i => (32 * i, expectedWord i)

@[simp] theorem targetInput_size : targetInput.size = 1000 := by
  simp [targetInput, ByteArray.size]

@[simp] theorem targetInput_getElem (i : Nat) (hi : i < targetInput.size) :
    targetInput[i] = 0x61 := by
  simp [targetInput, ByteArray.getElem_eq_getElem_data, Array.getElem_replicate]

theorem checks_length : checks.length = 32 := by
  simp [checks]

@[simp] theorem targetInput_readWord (i : Nat) (hi : i < 32) :
    MachineState.readWord targetInput (32 * i) = expectedWord i := by
  by_cases hfull : i < 31
  · have hread : MachineState.readPadded targetInput (32 * i) 32 =
        ByteArray.mk (Array.replicate 32 0x61) := by
      apply ByteArray.ext_getElem
      · rw [Challenge.EvmProof.Memory.readPadded_size]
        norm_num [ByteArray.size]
      · intro j hj₁ hj₂
        have hj : j < 32 := by
          rw [Challenge.EvmProof.Memory.readPadded_size] at hj₁
          exact hj₁
        have hsource : 32 * i + j < targetInput.size := by
          rw [targetInput_size]
          omega
        rw [← Challenge.EvmProof.Memory.getD0_eq_getElem _ _ hj₁,
          Challenge.EvmProof.Memory.readPadded_getElem?_getD]
        rw [if_pos hj, Challenge.EvmProof.Memory.getD0_eq_getElem _ _ hsource,
          targetInput_getElem _ hsource]
        change (0x61 : UInt8) = (Array.replicate 32 0x61)[j]
        rw [Array.getElem_replicate]
    unfold MachineState.readWord expectedWord
    rw [hread, if_pos hfull]
    apply Challenge.EvmProof.Word.word_ext
    have h97 : UInt8.toNat (97 : UInt8) = 97 := by decide
    norm_num [Data.Bytes.bytesToBigEndianNat,
      Challenge.EvmProof.Bytecode.toList_eq_data, Array.toList_replicate,
      List.replicate_succ, List.foldl, h97, fullWord,
      Challenge.EvmProof.Word.word_toNat_ofNat]
  · have hieq : i = 31 := by omega
    subst i
    have hread : MachineState.readPadded targetInput (32 * 31) 32 =
        ByteArray.mk (Array.replicate 8 (0x61 : UInt8) ++
          Array.replicate 24 (0 : UInt8)) := by
      apply ByteArray.ext_getElem
      · rw [Challenge.EvmProof.Memory.readPadded_size]
        norm_num [ByteArray.size]
      · intro j hj₁ hj₂
        have hj : j < 32 := by
          rw [Challenge.EvmProof.Memory.readPadded_size] at hj₁
          exact hj₁
        rw [← Challenge.EvmProof.Memory.getD0_eq_getElem _ _ hj₁,
          Challenge.EvmProof.Memory.readPadded_getElem?_getD]
        by_cases hj8 : j < 8
        · have hsource : 32 * 31 + j < targetInput.size := by
            rw [targetInput_size]
            omega
          rw [if_pos hj, Challenge.EvmProof.Memory.getD0_eq_getElem _ _ hsource,
            targetInput_getElem _ hsource]
          change (0x61 : UInt8) =
            (Array.replicate 8 (0x61 : UInt8) ++
              Array.replicate 24 (0 : UInt8))[j]
          rw [Array.getElem_append_left hj8, Array.getElem_replicate]
        · have hsource : targetInput.size ≤ 32 * 31 + j := by
            rw [targetInput_size]
            omega
          rw [if_pos hj,
            Challenge.EvmProof.Memory.getElem?_getD_eq_zero_of_size_le _ _ hsource]
          change (0 : UInt8) =
            (Array.replicate 8 (0x61 : UInt8) ++
              Array.replicate 24 (0 : UInt8))[j]
          rw [Array.getElem_append_right (Nat.le_of_not_gt hj8),
            Array.getElem_replicate]
    unfold MachineState.readWord expectedWord
    rw [hread]
    apply Challenge.EvmProof.Word.word_ext
    have h97 : UInt8.toNat (97 : UInt8) = 97 := by decide
    have hzero : UInt8.toNat (0 : UInt8) = 0 := by decide
    norm_num [Data.Bytes.bytesToBigEndianNat,
      Challenge.EvmProof.Bytecode.toList_eq_data, Array.toList_append,
      Array.toList_replicate, List.replicate_succ, List.foldl,
      h97, hzero, finalWord,
      Challenge.EvmProof.Word.word_toNat_ofNat]

end Challenge.Ripemd160.Submission.Proofs.Bytecode.KnownInputData
